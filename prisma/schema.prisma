// Health Project Hub — data model
// Couvre le cœur du cahier des charges : hiérarchie Groupe > Établissement > Projet,
// réunions, actions, risques, décisions, interfaces, anomalies, formation/autonomie,
// documents et timeline. Les modules non couverts par l'UI (export, parsing mail IA,
// génération de documents) sont listés en roadmap dans le README, mais le schéma
// laisse la place pour les brancher (voir DocumentRef, TimelineEvent).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Group {
  id             String          @id @default(cuid())
  name           String
  establishments Establishment[]
  initiatives       Initiative[]
  actorAffiliations ActorAffiliation[]
  createdAt      DateTime        @default(now())
}

model Establishment {
  id           String                 @id @default(cuid())
  name         String
  groupId      String
  group        Group                  @relation(fields: [groupId], references: [id])
  type         String? // hopital | clinique | ehpad | cabinet | ght | autre
  localisation String?
  status       String                 @default("actif") // actif | inactif

  // Infos générales (architecture Groupe > Établissement > Initiative)
  adresse             String?
  ville               String?
  pays                String?
  siteWeb             String?
  activite            String?
  nombreLits          Int?
  nombrePlaces        Int?
  nombreUtilisateurs  Int?

  // Contrat
  dateSignature   DateTime?
  dateDemarrage   DateTime?
  dateFin         DateTime?
  montantAnnuel   Float?
  maintenance     String?
  support         String?

  installedProducts    InstalledProduct[]
  incidents            Incident[]
  ecosystemInterfaces  EstablishmentInterface[]
  actorAffiliations    ActorAffiliation[]

  initiatives  InitiativeEstablishment[]
  trainings    TrainingRecord[]
  risks        Risk[]
  actions      Action[]
  requirementApplicabilities RequirementApplicability[]
  createdAt    DateTime               @default(now())
}

// Produits installés chez un établissement (distinct du travail interop en
// cours dans une Initiative — ceci est l'inventaire de l'existant).
model InstalledProduct {
  id              String        @id @default(cuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  name            String
  version         String?
  dateInstallation DateTime?
  status          String        @default("actif") // actif | en_projet | desactive
  createdAt       DateTime      @default(now())
}

// Écosystème d'interfaces existantes chez un établissement (inventaire), à ne
// pas confondre avec le modèle Interface qui suit le travail interop en cours
// à l'intérieur d'une Initiative.
model EstablishmentInterface {
  id              String        @id @default(cuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  type            String // laboratoire | ris | pacs | erp | sirh | pmsi | mssante | dmp | autre
  editeurTiers    String?
  status          String        @default("active") // active | en_projet | desactivee
  notes           String?
  createdAt       DateTime      @default(now())
}

model Actor {
  id              String      @id @default(cuid())
  initiativeId       String? @map("projectId")
  initiative         Initiative?     @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  name            String
  // Désactivation douce plutôt que suppression : un Acteur est référencé par
  // beaucoup d'historique (RACI, actions, risques, décisions, réunions,
  // formations, incidents, chefDeProjet/sponsor d'Initiative). Le supprimer
  // pour de vrai effacerait ou casserait cet historique. `actif = false`
  // retire l'acteur des listes de sélection sans toucher à l'existant.
  actif           Boolean     @default(true)
  fonction        String?
  organisation    String?
  roleProjet      String? // chef_de_projet | consultant | consultant_fonctionnel | consultant_interop | expert_metier | developpeur | formateur | support | expert_externe | referent_etablissement
  email           String?
  telephone       String?
  disponibiliteJh Float?
  competences     String?
  affiliations    ActorAffiliation[]
  account         User?
  raciEntries     RaciEntry[]
  actionsResponsable      Action[]           @relation("ActionResponsable")
  risksProprietaire       Risk[]             @relation("RiskProprietaire")
  interfacesResponsable   Interface[]        @relation("InterfaceResponsable")
  deliverablesResponsable Deliverable[]      @relation("DeliverableResponsable")
  decisionsDecideur       Decision[]         @relation("DecisionDecideur")
  meetingParticipations   MeetingParticipant[]
  trainingSessionsAsFormateur TrainingSession[] @relation("TrainingFormateur")
  trainingRecordsAsReferent   TrainingRecord[]  @relation("TrainingReferent")
  incidentsDeclares           Incident[]        @relation("IncidentDeclarant")
  initiativesAsChefDeProjet   Initiative[]      @relation("InitiativeChefDeProjet")
  unavailabilities            ActorUnavailability[]
  allocations                  ActorAllocation[]
  initiativesAsSponsor        Initiative[]      @relation("InitiativeSponsor")
  createdAt       DateTime    @default(now())
}

// Référentiel Acteur transverse (architecture Groupe > Établissement > Initiative,
// §5) : un acteur peut être contact d'un Groupe, contact d'un Établissement, et/ou
// impliqué dans une ou plusieurs Initiatives. L'implication dans une Initiative
// passe déjà par les relations existantes (RaciEntry, MeetingParticipant,
// *Responsable, *Decideur...) — cette table couvre spécifiquement le rattachement
// "contact officiel de" à un Groupe ou un Établissement, qui n'existait pas avant.
// Une ligne = un rattachement à un seul niveau (groupId OU establishmentId rempli,
// jamais les deux) ; un acteur peut avoir plusieurs rattachements (ex. contact de
// deux établissements du même groupe).
model ActorAffiliation {
  id              String         @id @default(cuid())
  actorId         String
  actor           Actor          @relation(fields: [actorId], references: [id], onDelete: Cascade)
  groupId         String?
  group           Group?         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  establishmentId String?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  role            String? // direction | direction_medicale | referent_metier | referent_informatique | referent_qualite | chef_de_projet_client | autre
  createdAt       DateTime       @default(now())

  @@unique([actorId, groupId, establishmentId, role])
}

// Table de jointure Réunion ↔ Acteur (§3 des exigences complémentaires) — une
// réunion a plusieurs participants, un acteur peut participer à plusieurs
// réunions.
model MeetingParticipant {
  id        String   @id @default(cuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  actorId   String
  actor     Actor    @relation(fields: [actorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([meetingId, actorId])
}

model RaciEntry {
  id        String   @id @default(cuid())
  initiativeId String @map("projectId")
  initiative   Initiative  @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  actorId   String
  actor     Actor    @relation(fields: [actorId], references: [id], onDelete: Cascade)
  activite  String
  role      String // R | A | C | I
  createdAt DateTime @default(now())

  @@unique([actorId, activite])
}

model Initiative {
  id          String   @id @default(cuid())
  reference   String
  name        String
  description String? // sert de "Contexte" dans l'écran Cadrage
  enjeux          String?
  objectifs       String?
  perimetre       String?
  exclusions      String?
  hypotheses      String?
  contraintes     String?
  criteresSucces  String?
  // Liste cible réconciliée (architecture Groupe > Établissement > Initiative) :
  // deploiement | evolution | interoperabilite | migration | mise_a_niveau |
  // cybersecurite | reglementaire | formation | audit | autre.
  // Anciennes valeurs migrées automatiquement (voir prisma/migrate-initiative-types.ts) :
  // changement_version → mise_a_niveau, remplacement → migration,
  // mise_en_conformite → reglementaire, optimisation → evolution.
  type        String
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id])

  // Champs texte legacy — conservés en secours d'affichage/compatibilité.
  // Ne pas supprimer avant validation complète de la migration vers
  // chefDeProjetId/sponsorId en production (voir prisma/migrate-chef-sponsor.ts).
  chefDeProjet String?
  sponsor      String?

  // Rattachement au référentiel Acteur (chantier "chefDeProjet/sponsor →
  // Acteur"). Optionnels : peuvent rester non renseignés tant que la
  // migration n'a pas statué sur un cas donné.
  chefDeProjetId String?
  chefDeProjetActor Actor? @relation("InitiativeChefDeProjet", fields: [chefDeProjetId], references: [id])
  sponsorId      String?
  sponsorActor   Actor? @relation("InitiativeSponsor", fields: [sponsorId], references: [id])

  startDate  DateTime?
  targetDate DateTime?
  status     String   @default("actif") // actif | en_pause | cloture
  phase      String   @default("cadrage")
  priority   String   @default("normale") // basse | normale | haute | critique
  healthOverride String? // permet de forcer manuellement vert/orange/rouge si besoin

  budgetJh     Float @default(0)
  jhPlanifies  Float @default(0)
  jhConsommes  Float @default(0)

  devise           String @default("EUR")
  budgetInitialEur Float?
  budgetReviseEur  Float?

  establishments   InitiativeEstablishment[]
  meetings         Meeting[]
  actions          Action[]
  risks            Risk[]
  decisions        Decision[]
  interfaces       Interface[]
  vigilancePoints  VigilancePoint[]
  anomalies        Anomaly[]
  trainings        TrainingRecord[]
  trainingSessions TrainingSession[]
  documents        DocumentRef[]
  timelineEvents   TimelineEvent[]
  baselines        PlanningBaseline[]
  backlogItems     BacklogItem[]
  budgetLines      BudgetLine[]
  deliverables     Deliverable[]
  stakeholders     Stakeholder[]
  kpis             Kpi[]
  changeRequests   ChangeRequest[]
  actors           Actor[]
  allocations      ActorAllocation[]
  raciEntries      RaciEntry[]
  requirements     Requirement[]
  gaps             Gap[]
  goalContributions InitiativeGoalContribution[]
  requirementCoverages InitiativeRequirementCoverage[]
  stageCriteria    StageCriterion[]
  // Moteur de modèles de projet : version du modèle appliquée à la création
  // (null = initiative antérieure au moteur ou sans modèle → repli sur WorkflowStage).
  templateId       String?
  template         ProjectTemplate? @relation(fields: [templateId], references: [id])
  profileFlags     String[] @default([])
  stages           InitiativeStage[]
  gateDecisions    StageGateDecision[]
  relationsSource  InitiativeRelation[] @relation("RelationSource")
  relationsCible   InitiativeRelation[] @relation("RelationCible")
  incidents        Incident[]
  problems         Problem[]
  releases         Release[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Project")
}

// Critères de passage du parcours projet (§16-17 du cahier des charges "parcours
// certification") — uniquement pour les étapes qui n'ont pas déjà un indicateur
// calculé à partir de données réelles ailleurs dans l'app (Cadrage/Déploiement/
// Validation/Formation/Mise en production/Stabilisation restent pilotés par
// src/lib/readiness.ts, qui lit les objets transverses existants). Kick-off,
// Préparation et Clôture n'ont pas d'équivalent — ce modèle sert de checklist
// manuelle pour ces trois étapes, une checklist par défaut étant amorcée à la
// première visite de la page (voir src/lib/stageCriteria.ts).
// Modèles de checklist par étape, personnalisables par type de projet (§17 du
// cahier des charges : « Prévoir des checklists configurables par type de
// projet »). "defaut" est le modèle de repli utilisé par tout projet dont le
// type n'a pas (encore) sa propre liste — gérable depuis Paramètres > Critères.
// Séquence d'étapes du workflow, par type d'initiative (architecture Groupe >
// Établissement > Initiative, §6). Remplace la constante STAGES qui était codée
// en dur dans lib/lifecycle.ts — chaque type a son propre socle, éditable ici.
model WorkflowStage {
  id             String   @id @default(cuid())
  initiativeType String
  ordre          Int
  key            String
  label          String
  legacyPhases   String[] @default([])
  createdAt      DateTime @default(now())

  @@unique([initiativeType, key])
  @@unique([initiativeType, ordre])
}

// Relation entre deux Initiatives (architecture Groupe > Établissement >
// Initiative, §5). Orientée : source → cible. Pour les types symétriques
// (lie_a, conflit_avec, ressource_partagee_avec), la relation ne porte de sens
// que dans un sens de saisie, mais s'affiche dans les deux fiches concernées.
// `auto=true` distingue les relations posées automatiquement par le système
// (détection de conflit de planning, §9 point 4) de celles déclarées à la main.
model InitiativeRelation {
  id                 String     @id @default(cuid())
  initiativeSourceId String
  initiativeSource   Initiative @relation("RelationSource", fields: [initiativeSourceId], references: [id], onDelete: Cascade)
  initiativeCibleId  String
  initiativeCible    Initiative @relation("RelationCible", fields: [initiativeCibleId], references: [id], onDelete: Cascade)
  type               String // depend_de | prerequis_pour | impacte | lie_a | conflit_avec | ressource_partagee_avec
  note               String?
  auto               Boolean    @default(false)
  createdAt          DateTime   @default(now())

  @@unique([initiativeSourceId, initiativeCibleId, type])
}

// Volet exploitation post-déploiement (inspiré ITIL) : Incident → peut être
// rattaché à un Problème (cause racine commune à plusieurs incidents) ;
// Release regroupe les changements déployés ensemble.
model Incident {
  id               String        @id @default(cuid())
  initiativeId     String
  initiative       Initiative    @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  establishmentId  String?
  establishment    Establishment? @relation(fields: [establishmentId], references: [id])
  titre            String
  description      String?
  gravite          String        @default("mineure") // mineure | majeure | critique
  status           String        @default("ouvert") // ouvert | en_cours | resolu | cloture
  dateDetection    DateTime      @default(now())
  dateResolution   DateTime?
  resolution       String?
  problemId        String?
  problem          Problem?      @relation(fields: [problemId], references: [id])
  declarantActorId String?
  declarantActor   Actor?        @relation("IncidentDeclarant", fields: [declarantActorId], references: [id])
  createdAt        DateTime      @default(now())
}

model Problem {
  id           String     @id @default(cuid())
  initiativeId String
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  titre        String
  causeRacine  String?
  status       String     @default("investigation") // investigation | cause_identifiee | solution_en_cours | resolu
  incidents    Incident[]
  createdAt    DateTime   @default(now())
}

model Release {
  id              String          @id @default(cuid())
  initiativeId    String
  initiative      Initiative      @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  version         String
  dateDeploiement DateTime?
  contenu         String?
  status          String          @default("planifiee") // planifiee | deployee | annulee
  changeRequests  ChangeRequest[]
  createdAt       DateTime        @default(now())
}

model StageCriterionTemplate {
  id          String   @id @default(cuid())
  initiativeType String @map("projectType") // deploiement | migration | evolution | ... | defaut
  stageKey    String // kickoff | preparation | cloture
  label       String
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@unique([initiativeType, stageKey, label])
}

model StageCriterion {
  id        String   @id @default(cuid())
  initiativeId String @map("projectId")
  initiative   Initiative  @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  stageKey  String // kickoff | preparation | cloture
  label     String
  status    String   @default("non_commence") // non_commence | en_cours | bloque | pret
  order     Int      @default(0)
  // Moteur de modèles : rattachement optionnel à l'étape instanciée + règles du critère.
  initiativeStageId String?
  initiativeStage   InitiativeStage? @relation(fields: [initiativeStageId], references: [id], onDelete: SetNull)
  obligatoire Boolean @default(true)
  mode        String  @default("manuel") // manuel | auto | hybride
  autoSource  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([initiativeId, stageKey, label])
}

model InitiativeEstablishment {
  id              String        @id @default(cuid())
  initiativeId       String @map("projectId")
  establishmentId String
  initiative         Initiative       @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  phase           String? // surcharge optionnelle de la phase du projet pour ce site précis
                           // (utilisée par la vue comparative multi-établissements) — hérite de
                           // Initiative.phase tant qu'elle n'est pas renseignée.

  @@unique([initiativeId, establishmentId])
  @@map("ProjectEstablishment")
}

model PlanningBaseline {
  id        String   @id @default(cuid())
  initiativeId String @map("projectId")
  initiative   Initiative  @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  label     String // "Baseline initiale", "Révision 1 (arbitrage COPIL 06/09)"...
  targetDate DateTime
  reason    String? // justification de la révision (vide pour la baseline initiale)
  createdAt DateTime @default(now())
}

model Meeting {
  id           String   @id @default(cuid())
  initiativeId    String @map("projectId")
  initiative      Initiative  @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  type         String // kick-off | comite_projet | copil | atelier_metier | atelier_interop | atelier_parametrage | suivi | go_no_go | hypercare | retex
  title        String
  date         DateTime
  heureFin     String? // "HH:mm" — fin de réunion, même jour que `date` (qui porte déjà l'heure de début via datetime-local)
  participants String? // liste libre, séparée par virgules — legacy, conservé en secours d'affichage
  meetingParticipants MeetingParticipant[]
  agenda       String?
  notes        String?

  decisions Decision[]
  actions   Action[]
  risks     Risk[]

  createdAt DateTime @default(now())
}

model Action {
  id             String    @id @default(cuid())
  initiativeId      String?   @map("projectId")
  initiative        Initiative?  @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  ownerType      String    @default("initiative") // groupe | etablissement | initiative
  ownerId        String?
  meetingId      String?
  meeting        Meeting?  @relation(fields: [meetingId], references: [id])
  riskId         String?
  risk           Risk?     @relation(fields: [riskId], references: [id])
  decisionId     String?
  decision       Decision? @relation(fields: [decisionId], references: [id])
  auditFindingId String?
  auditFinding   AuditFinding? @relation(fields: [auditFindingId], references: [id])
  establishmentId String?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id])
  responsableActorId String?
  responsableActor   Actor? @relation("ActionResponsable", fields: [responsableActorId], references: [id])
  title          String
  responsable    String?
  dateDebut      DateTime?
  echeance       DateTime?
  priority       String    @default("normale")
  origine        String?   // reunion | risque | decision | audit | mail | document | manuel
  status         String    @default("a_faire") // a_faire | en_cours | en_attente | termine | abandonne
  comments       String?
  postponedCount Int       @default(0)
  // Moteur de modèles (Lot 2) : étape de l'initiative à laquelle cet élément est rattaché (optionnel).
  initiativeStageId String?
  // Plan d'action : objectif (cycle de plan) servi par l'action, et livrable / preuve attendu.
  strategicGoalCycleId String?
  strategicGoalCycle   StrategicGoalCycle? @relation(fields: [strategicGoalCycleId], references: [id], onDelete: SetNull)
  livrable             String?
  // Indicateur que l'action vise à faire progresser, et exigence qu'elle traite (liens facultatifs).
  indicatorId          String?
  indicator            GoalIndicator? @relation(fields: [indicatorId], references: [id], onDelete: SetNull)
  qualityRequirementId String?
  qualityRequirement   QualityRequirement? @relation(fields: [qualityRequirementId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Risk {
  id           String    @id @default(cuid())
  initiativeId    String?   @map("projectId")
  initiative      Initiative?  @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  ownerType    String    @default("initiative") // groupe | etablissement | initiative
  ownerId      String?
  meetingId    String?
  meeting      Meeting?  @relation(fields: [meetingId], references: [id])
  interfaceId  String?
  interfaceRef Interface? @relation(fields: [interfaceId], references: [id])
  establishmentId String?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id])
  description  String
  cause        String?
  consequence  String?
  probabilite  String @default("moyenne") // faible | moyenne | forte
  impact       String @default("moyen") // faible | moyen | fort
  criticite    String @default("moyenne") // faible | moyenne | forte | critique
  proprietaire String?
  proprietaireActorId String?
  proprietaireActor   Actor? @relation("RiskProprietaire", fields: [proprietaireActorId], references: [id])
  planAction   String?
  echeance     DateTime?
  status       String @default("ouvert") // ouvert | en_traitement | maitrise | cloture
  // Moteur de modèles (Lot 2) : étape de l'initiative à laquelle cet élément est rattaché (optionnel).
  initiativeStageId String?
  goalLinks StrategicGoalLink[]
  createdAt    DateTime @default(now())
  actions      Action[]
}

model Decision {
  id             String    @id @default(cuid())
  initiativeId      String?   @map("projectId")
  initiative        Initiative?  @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  ownerType      String    @default("initiative") // groupe | etablissement | initiative
  ownerId        String?
  meetingId      String?
  meeting        Meeting?  @relation(fields: [meetingId], references: [id])
  subject        String
  context        String?
  options        String?
  recommendation String?
  decideur       String?
  decideurActorId String?
  decideurActor   Actor? @relation("DecisionDecideur", fields: [decideurActorId], references: [id])
  decision       String?
  date           DateTime?
  impact         String?
  status         String @default("en_attente") // decision_prise | en_attente | arbitrage_necessaire
  // Moteur de modèles (Lot 2) : étape de l'initiative à laquelle cet élément est rattaché (optionnel).
  initiativeStageId String?
  goalLinks StrategicGoalLink[]
  createdAt      DateTime @default(now())
  actions        Action[]
}

model Interface {
  id            String   @id @default(cuid())
  initiativeId     String @map("projectId")
  initiative       Initiative  @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  name          String
  systemeSource String?
  systemeCible  String?
  flux          String?
  protocole     String?
  standard      String?
  responsable   String?
  responsableActorId String?
  responsableActor   Actor? @relation("InterfaceResponsable", fields: [responsableActorId], references: [id])
  fournisseur   String?
  status        String   @default("a_specifier") // a_specifier | en_developpement | en_test | valide | bloquant
  datePrevue    DateTime?
  dateReelle    DateTime?
  dateTest      DateTime?
  resultat      String?
  isBlocking    Boolean  @default(false)
  risks         Risk[]
  createdAt     DateTime @default(now())
}

model VigilancePoint {
  id          String   @id @default(cuid())
  initiativeId   String @map("projectId")
  initiative     Initiative  @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  description String
  status      String   @default("a_surveiller") // a_surveiller | requalifie | clos
  convertedTo String? // action | risque | decision | evolution
  createdAt   DateTime @default(now())
}

model Anomaly {
  id             String    @id @default(cuid())
  initiativeId      String @map("projectId")
  initiative        Initiative   @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  description    String
  origine        String?
  environnement  String?
  criticite      String    @default("moyenne") // mineure | moyenne | majeure | critique
  responsable    String?
  correction     String?
  dateCorrection DateTime?
  status         String    @default("ouverte") // ouverte | en_correction | corrigee | validee
  createdAt      DateTime  @default(now())
}

model TrainingRecord {
  id              String         @id @default(cuid())
  initiativeId       String @map("projectId")
  initiative         Initiative        @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  establishmentId String?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id])
  service         String?
  metier          String?
  profil          String?
  nbUsers         Int            @default(0)
  nbFormes        Int            @default(0)
  autonomyLevel   Int            @default(0) // 0..4 cf. échelle §27
  referent        String?
  referentActorId String?
  referentActor   Actor? @relation("TrainingReferent", fields: [referentActorId], references: [id])
  referentContact String?
  dateFormation   DateTime?
  sessions        TrainingSession[]
  createdAt       DateTime       @default(now())
}

model TrainingSession {
  id               String         @id @default(cuid())
  initiativeId        String @map("projectId")
  initiative          Initiative        @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  trainingRecordId String
  trainingRecord   TrainingRecord @relation(fields: [trainingRecordId], references: [id], onDelete: Cascade)
  date             DateTime
  heureDebut       String? // "HH:mm" — si renseignée avec heureFin, dureeHeures est calculée automatiquement à la création
  heureFin         String? // "HH:mm"
  dureeHeures      Float?
  formateur        String?
  formateurActorId String?
  formateurActor   Actor? @relation("TrainingFormateur", fields: [formateurActorId], references: [id])
  format           String? // presentiel | distanciel | elearning
  nbInscrits       Int            @default(0)
  nbPresents       Int            @default(0)
  notes            String?
  createdAt        DateTime       @default(now())
}

model DocumentRef {
  id          String   @id @default(cuid())
  initiativeId   String?   @map("projectId")
  initiative     Initiative?  @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  ownerType   String   @default("initiative") // groupe | etablissement | initiative
  ownerId     String?
  title       String
  type        String? // compte_rendu | specification | recette | formation | interop | mail | autre
  note        String? // résumé ou contenu texte (mail collé, etc.)
  fileUrl     String? // URL Vercel Blob du fichier réel, si upload (distinct d'un texte collé dans `note`)
  fileName    String?
  fileSize    Int?
  mimeType    String?
  linkedType  String? // action | risque | decision | interface | reunion | anomalie
  linkedId    String?
  createdAt   DateTime @default(now())
}

model TimelineEvent {
  id          String   @id @default(cuid())
  initiativeId   String @map("projectId")
  initiative     Initiative  @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  date        DateTime @default(now())
  type        String // reunion | action | risque | decision | interface | anomalie | planning | document
  description String

  createdAt DateTime @default(now())
}

model BacklogItem {
  id          String   @id @default(cuid())
  initiativeId   String @map("projectId")
  initiative     Initiative  @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  demande     String
  origine     String?
  description String?
  impact      String?
  priorite    String   @default("normale")
  estimationJh Float?
  decision    String?  // accepte | rejete | en_etude
  status      String   @default("nouveau") // nouveau | qualifie | planifie | realise | rejete
  createdAt   DateTime @default(now())
}

model BudgetLine {
  id          String   @id @default(cuid())
  initiativeId   String @map("projectId")
  initiative     Initiative  @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  libelle     String
  categorie   String? // prestation | licence | ressource | deplacement | fournisseur | autre
  fournisseur String?
  prevision   Float    @default(0)
  engage      Float    @default(0)
  reel        Float    @default(0)
  createdAt   DateTime @default(now())
}

model Deliverable {
  id          String    @id @default(cuid())
  initiativeId   String @map("projectId")
  initiative     Initiative   @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  name        String
  description String?
  responsable String?
  responsableActorId String?
  responsableActor   Actor? @relation("DeliverableResponsable", fields: [responsableActorId], references: [id])
  datePrevue  DateTime?
  heureDebut  String? // "HH:mm" — optionnel, seulement si le livrable correspond à une session programmée (ex. recette) avec le responsable
  heureFin    String?
  dateReelle  DateTime?
  version     String?
  status      String    @default("a_venir") // a_venir | en_cours | valide | rejete
  // Moteur de modèles (Lot 2) : étape de l'initiative à laquelle cet élément est rattaché (optionnel).
  initiativeStageId String?
  createdAt   DateTime  @default(now())
}

model Stakeholder {
  id           String   @id @default(cuid())
  initiativeId    String @map("projectId")
  initiative      Initiative  @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  name         String
  organisation String?
  role         String?
  implication  String? // faible | moyenne | forte
  influence    String? // faible | moyenne | forte
  contact      String?
  comments     String?
  createdAt    DateTime @default(now())
}

model Kpi {
  id             String   @id @default(cuid())
  initiativeId      String @map("projectId")
  initiative        Initiative  @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  name           String
  value          Float
  unit           String?
  target         Float?
  period         String?
  categorie      String? // adoption | avancement | qualite | autre
  alertThreshold Float?
  // Moteur de modèles (Lot 2) : étape de l'initiative à laquelle cet élément est rattaché (optionnel).
  initiativeStageId String?
  createdAt      DateTime @default(now())
}

model ChangeRequest {
  id                  String    @id @default(cuid())
  initiativeId           String @map("projectId")
  initiative             Initiative   @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  titre               String
  origine             String? // reunion | mail | audit | reglementaire | autre
  demandeur           String?
  justification       String?
  perimetre           String?
  impactFonctionnel   String?
  impactPlanningJours Int?
  impactJh            Float?
  impactInterop       String?
  impactFormation     String?
  impactRisque        String?
  nouvelleDateCible   DateTime?
  decision            String    @default("en_etude") // en_etude | accepte | rejete
  decideur            String?
  dateDecision        DateTime?
  releaseId           String?
  release             Release?  @relation(fields: [releaseId], references: [id])
  createdAt           DateTime  @default(now())
}

model Requirement {
  id          String   @id @default(cuid())
  initiativeId   String @map("projectId")
  initiative     Initiative  @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  titre       String
  description String?
  origine     String? // atelier_metier | reglementaire | technique | utilisateur | autre
  priorite    String   @default("normale") // basse | normale | haute
  statut      String   @default("a_analyser") // a_analyser | retenu | rejete | en_attente_arbitrage
  gaps        Gap[]
  createdAt   DateTime @default(now())
}

model Gap {
  id                  String       @id @default(cuid())
  initiativeId           String @map("projectId")
  initiative             Initiative      @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  requirementId       String?
  requirement         Requirement? @relation(fields: [requirementId], references: [id])
  description         String
  optionsEnvisagees   String?
  decisionRetenue     String?
  impact              String?
  statut              String       @default("identifie") // identifie | arbitre | resolu
  createdAt           DateTime     @default(now())
}

// Authentification — Phase 6 (§17 du cahier des charges : identifier
// automatiquement "l'utilisateur connecté" au lieu d'une saisie manuelle de nom).
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?   // nullable : un compte "invited" n'a pas encore défini son mot de passe
  name         String
  telephone    String?
  avatarUrl    String?
  status       String    @default("active") // invited | active | suspended
  actorId      String?   @unique
  actor        Actor?    @relation(fields: [actorId], references: [id])
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  sessions     Session[]
  assignments  UserAssignment[]
  inviteTokens InviteToken[]
}

// Affectation rôle × périmètre — le cœur du système d'autorisation. Un
// utilisateur a une ligne par affectation (ex. Claire = chef_de_projet/groupe/G1
// ET chef_de_projet/initiative/X). scopeType="plateforme" est le seul cas où
// scopeId vaut le sentinel "GLOBAL" plutôt qu'un id réel — évite les pièges
// d'unicité Postgres sur colonnes NULL (NULL ≠ NULL dans une contrainte unique).
// Compatibilité rôle/scopeType vérifiée en code (src/lib/authz.ts), pas en base :
// administrateur → plateforme|groupe ; referent_etablissement → etablissement ;
// directeur → groupe|etablissement ; chef_de_projet → groupe|etablissement|initiative.
model UserAssignment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   // administrateur | referent_etablissement | directeur | chef_de_projet
  scopeType String   // plateforme | groupe | etablissement | initiative
  scopeId   String   // "GLOBAL" si scopeType = "plateforme"
  createdAt DateTime @default(now())

  @@unique([userId, role, scopeType, scopeId])
}

// Lien d'invitation à usage unique : définir son mot de passe active le
// compte (status "invited" → "active"). Pas d'email envoyé en V1 — le lien
// est affiché à l'administrateur pour qu'il le transmette lui-même, comme le
// code d'invitation partagé déjà en place aujourd'hui.
model InviteToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Journal d'audit générique — "qui a changé quoi, quand", tous objets métier
// confondus. entityLabel/userName sont des instantanés (texte figé au moment
// de l'action) : ils restent lisibles même si l'objet est renommé/supprimé ou
// si le compte utilisateur est supprimé — volontairement pas de relation FK
// vers les entités auditées (trop nombreuses et hétérogènes) ni vers User
// (userId gardé à titre indicatif seulement, non contraint).
model AuditLog {
  id          String   @id @default(cuid())
  entityType  String   // initiative | risk | action | decision | document | actor | establishment | group
  entityId    String
  entityLabel String
  action      String   // create | update | delete
  changes     Json?    // { champ: { from, to } }, uniquement pour action = update
  userId      String?
  userName    String
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// Période d'indisponibilité déclarée pour un Acteur (congés, mission externe,
// autre) — sert à détecter qu'une réunion est planifiée alors qu'un
// participant est indisponible sur cette période.
model ActorUnavailability {
  id        String   @id @default(cuid())
  actorId   String
  actor     Actor    @relation(fields: [actorId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@index([actorId])
}

// Allocation de charge déclarée pour un Acteur sur une Initiative, semaine par
// semaine (weekStart = lundi de la semaine, à minuit). joursAlloues est un JH
// déclaré manuellement — l'outil ne calcule ni n'estime rien automatiquement.
// Une ligne par (acteur, initiative, semaine) ; la charge totale d'un acteur
// sur une semaine se calcule en sommant ses lignes sur cette semaine, toutes
// initiatives confondues.
model ActorAllocation {
  id           String     @id @default(cuid())
  actorId      String
  actor        Actor      @relation(fields: [actorId], references: [id], onDelete: Cascade)
  initiativeId String
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  weekStart    DateTime
  joursAlloues Float
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([actorId, initiativeId, weekStart])
  @@index([actorId, weekStart])
  @@index([initiativeId])
}

// ---------------------------------------------------------------------------
// Chantier "vision gouvernance intégrée" — Phase 1 : donner du sens aux
// initiatives via des objectifs stratégiques versionnés par cycle de plan.
//
// StrategicGoal = identité stable d'un objectif ("Améliorer la sécurité
// médicamenteuse"). StrategicPlan = un exercice daté partagé par plusieurs
// objectifs ("Plan stratégique 2026–2028"). StrategicGoalCycle = la
// déclinaison d'un Goal dans un Plan donné (cible/indicateurs spécifiques à ce
// cycle, éventuelle reformulation) — c'est CE cycle, et non le Goal stable,
// qui reçoit les contributions d'Initiative, pour garder la traçabilité :
// "quels objectifs étaient poursuivis lors du plan précédent, et quelles
// initiatives y ont contribué" reste répondable sans jamais écraser
// l'historique d'un cycle passé.
//
// ownerType/ownerId réutilise le pattern du lot 3 (Risk/Action/Decision/
// DocumentRef), mais restreint à "groupe" | "etablissement" — un objectif
// stratégique n'est jamais porté par une initiative elle-même.
// ---------------------------------------------------------------------------

model StrategicPlan {
  id        String   @id @default(cuid())
  ownerType String // groupe | etablissement
  ownerId   String
  libelle   String
  startDate DateTime
  endDate   DateTime
  statut    String   @default("actif") // brouillon | actif | clos
  cycles    StrategicGoalCycle[]
  // Diffusion groupe → établissements : `diffuse` sur le plan du groupe ; `parentPlanId` sur la copie
  // de l'établissement (libellé, dates et statut suivent le plan du groupe et sont verrouillés).
  diffuse      Boolean @default(false)
  parentPlanId String?
  createdAt DateTime @default(now())

  @@unique([ownerId, parentPlanId])
  @@index([ownerType, ownerId])
}

model StrategicGoal {
  id          String   @id @default(cuid())
  ownerType   String // groupe | etablissement
  ownerId     String
  libelle     String
  description String?
  cycles      StrategicGoalCycle[]
  // Diffusion groupe → établissements (voir StrategicPlan) : libellé et description verrouillés
  // sur la copie ; cible, indicateurs et statut se saisissent sur le cycle de chaque établissement.
  diffuse      Boolean @default(false)
  parentGoalId String?
  createdAt   DateTime @default(now())

  @@unique([ownerId, parentGoalId])
  @@index([ownerType, ownerId])
}

model StrategicGoalCycle {
  id                String        @id @default(cuid())
  strategicGoalId   String
  strategicGoal     StrategicGoal @relation(fields: [strategicGoalId], references: [id], onDelete: Cascade)
  strategicPlanId   String
  strategicPlan     StrategicPlan @relation(fields: [strategicPlanId], references: [id], onDelete: Cascade)
  libelle           String? // reformulation propre à ce cycle ; si vide, on affiche le libellé du Goal stable
  statut            String        @default("actif") // actif | atteint | abandonne | reporte
  cible             String?
  indicateurs       String?
  contributions     InitiativeGoalContribution[]
  actions           Action[]
  // Objectif = unité de pilotage (refonte Objectifs & conformité).
  priorite           String    @default("normale") // basse | normale | haute | critique
  responsableActorId String?
  responsable        String?
  axe                String?
  resultatAttendu    String?
  perimetre          String? // population / périmètre concerné — distinct de l'indicateur et des valeurs
  echeance           DateTime?
  // Déclinaison établissement : cycle du groupe dont celui-ci est la copie (lien explicite).
  parentCycleId      String?
  diffusion          String    @default("aucune") // aucune | tous | selection
  indicators         GoalIndicator[]
  links              StrategicGoalLink[]
  updatedAt          DateTime  @default(now()) @updatedAt
  createdAt         DateTime      @default(now())

  @@unique([strategicGoalId, strategicPlanId])
  @@index([parentCycleId])
}

// Relation facultative des deux côtés (ni l'Initiative ni le Cycle n'imposent
// de contrepartie) : permet de détecter symétriquement les initiatives
// orphelines (aucune contribution) et les objectifs du plan actif non pris en
// charge par une initiative.
model InitiativeGoalContribution {
  id                   String             @id @default(cuid())
  initiativeId         String
  initiative           Initiative         @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  strategicGoalCycleId String
  strategicGoalCycle   StrategicGoalCycle @relation(fields: [strategicGoalCycleId], references: [id], onDelete: Cascade)
  niveau               String             @default("principale") // principale | secondaire
  createdAt            DateTime           @default(now())

  @@unique([initiativeId, strategicGoalCycleId])
}

// ---------------------------------------------------------------------------
// Chantier "vision gouvernance intégrée" — Phase 2 : référentiel qualité
// générique. Un seul modèle pour toutes les normes (ISO 9001, ISO 13485,
// HAS, ANQ, interne...) — `referentiel` est un champ libre, pas un objet par
// norme, pour éviter l'usine à gaz. `applicable=false` retire une exigence de
// la couverture calculée sans supprimer son historique (même logique douce
// que Actor.actif). Le statut de couverture (couverte/partielle/non couverte)
// n'est volontairement pas stocké : il se calcule à partir des lignes de
// InitiativeRequirementCoverage existantes, conformément au principe "jamais
// de donnée fabriquée dans l'UI".
// ---------------------------------------------------------------------------

model QualityRequirement {
  id          String   @id @default(cuid())
  ownerType   String // groupe | etablissement
  ownerId     String
  referentiel String // ISO 9001 | ISO 13485 | ISO 14971 | ISO 27001 | ISO 22301 | RGPD/LPD | ANQ | HAS | interne | autre
  code        String? // ex. "§7.5" — référence de clause, optionnel
  libelle     String
  description String?
  applicable  Boolean  @default(true)
  coverages   InitiativeRequirementCoverage[]
  auditFindings AuditFinding[]
  // Applicabilité : « tous » = tout le groupe sauf exclusions ; « selection » = seulement les établissements retenus.
  portee      String   @default("tous")
  applicabilities RequirementApplicability[]
  goalLinks   StrategicGoalLink[]
  actions     Action[]
  createdAt   DateTime @default(now())

  @@index([ownerType, ownerId])
}

// Relation facultative des deux côtés, même logique que
// InitiativeGoalContribution : détecte symétriquement les initiatives sans
// exigence couverte et les exigences applicables sans initiative.
model InitiativeRequirementCoverage {
  id                   String             @id @default(cuid())
  initiativeId         String
  initiative           Initiative         @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  qualityRequirementId String
  qualityRequirement   QualityRequirement @relation(fields: [qualityRequirementId], references: [id], onDelete: Cascade)
  niveau               String             @default("totale") // totale | partielle
  createdAt            DateTime           @default(now())

  @@unique([initiativeId, qualityRequirementId])
}

// ---------------------------------------------------------------------------
// Chantier "vision gouvernance intégrée" — Phase 3 : constats d'audit, liés
// (optionnellement) à une exigence qualité, générant des Actions correctrices
// via le champ Action.auditFindingId — pas de nouveau modèle d'action, on
// réutilise Action exactement comme pour un Risque ou une Décision
// (Action.riskId / Action.decisionId).
// ---------------------------------------------------------------------------

model AuditFinding {
  id                   String   @id @default(cuid())
  ownerType            String // groupe | etablissement
  ownerId              String
  qualityRequirementId String?
  qualityRequirement   QualityRequirement? @relation(fields: [qualityRequirementId], references: [id], onDelete: SetNull)
  type                 String   @default("ecart") // ecart | observation | point_fort
  libelle              String
  description          String?
  dateConstat          DateTime @default(now())
  statut               String   @default("ouvert") // ouvert | en_traitement | cloture
  actions              Action[]
  goalLinks StrategicGoalLink[]
  createdAt            DateTime @default(now())

  @@index([ownerType, ownerId])
}


// ============================================================================
// MOTEUR DE MODÈLES DE PROJET (Lot 1) — strictement additif.
// Type de projet → Modèle versionné → Parcours → Étapes (Modèle × Étape).
// Les anciens WorkflowStage / StageCriterionTemplate restent en place (repli).
// ============================================================================

model ProjectType {
  id          String   @id @default(cuid())
  key         String   @unique // = Initiative.type (clés historiques conservées)
  label       String
  family      String   @default("autres")
  description String?
  ordre       Int      @default(0)
  actif       Boolean  @default(true)
  archive     Boolean  @default(false)
  system      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Bibliothèque d'étapes réutilisables.
model StageDefinition {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  description String?
  objectif    String?
  actif       Boolean  @default(true)
  system      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectTemplate {
  id          String   @id @default(cuid())
  typeKey     String
  familyId    String // regroupe les versions d'un même modèle
  name        String
  description String?
  version     Int      @default(1)
  status      String   @default("brouillon") // brouillon | actif | archive
  isGeneral   Boolean  @default(false) // Modèle général (repli de tout type sans modèle)
  parentTemplateId String? // modèle dupliqué
  stages      TemplateStage[]
  initiatives Initiative[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([familyId, version])
  @@index([typeKey, status])
}

// Configuration "Modèle + Étape".
model TemplateStage {
  id          String   @id @default(cuid())
  templateId  String
  template    ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  position    Int
  key         String
  label       String
  stageDefKey String?
  description String?
  objectif    String?
  obligatoire Boolean  @default(true)
  active      Boolean  @default(true)
  legacyPhases String[] @default([])
  gateMode    String? // null | consultatif | bloquant (Gates : Lot 2)
  config      Json? // réservé aux règles d'activation / Gate (Lot 2)
  criteria    TemplateStageCriterion[]
  items       TemplateStageItem[]

  @@unique([templateId, key])
  @@index([templateId, position])
}

model TemplateStageCriterion {
  id              String  @id @default(cuid())
  templateStageId String
  templateStage   TemplateStage @relation(fields: [templateStageId], references: [id], onDelete: Cascade)
  label           String
  order           Int     @default(0)
  obligatoire     Boolean @default(true)
  mode            String  @default("manuel") // manuel | auto | hybride
  autoSource      String?
}

// Structure générique : "dans cette étape, pour ce modèle, cet élément est attendu"
// (kind = action | livrable | risque | decision | indicateur | role | information).
// Posée au Lot 1, exposée au Lot 2.
model TemplateStageItem {
  id              String  @id @default(cuid())
  templateStageId String
  templateStage   TemplateStage @relation(fields: [templateStageId], references: [id], onDelete: Cascade)
  kind            String
  label           String
  order           Int     @default(0)
  obligatoire     Boolean @default(true)
  config          Json?
}

// Copie figée du parcours pour une initiative (jamais modifiée par l'édition du modèle).
model InitiativeStage {
  id              String   @id @default(cuid())
  initiativeId    String   @map("projectId")
  initiative      Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  templateStageId String?
  key             String
  label           String
  objectif        String?
  position        Int
  obligatoire     Boolean  @default(true)
  active          Boolean  @default(true)
  legacyPhases    String[] @default([])
  gateMode        String?
  // Éléments attendus (copie figée du modèle) : [{ kind, label, obligatoire }] — Lot 2.
  expected        Json?
  criteria        StageCriterion[]
  createdAt       DateTime @default(now())

  @@unique([initiativeId, key])
  @@index([initiativeId, position])
}

// Décisions de Gate : append-only (jamais modifiées ni supprimées), traçables (date, utilisateur,
// décision, commentaire). Une décision HPH (`Decision`) est aussi créée et reliée via decisionId.
model StageGateDecision {
  id           String   @id @default(cuid())
  initiativeId String   @map("projectId")
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  stageKey     String
  stageLabel   String
  outcome      String // go | go_reserves | no_go
  comment      String?
  unmetCount   Int      @default(0)
  gateMode     String?
  userId       String?
  userName     String?
  decisionId   String?
  createdAt    DateTime @default(now())

  @@index([initiativeId, stageKey])
}


// ============================================================================
// REFONTE OBJECTIFS & CONFORMITÉ (Lot 1) — strictement additif.
// Objectif → Indicateur → Mesure ; liens transversaux ; applicabilité des exigences.
// ============================================================================

// Définition d'un indicateur : maîtrisée au niveau Groupe. La copie d'un établissement (parentIndicatorId)
// hérite de la définition (nom, description, unité, sens, fréquence — verrouillés) et renseigne sa valeur
// initiale, ses mesures et, si elle diffère, sa cible locale (valeurCible vide = cible du Groupe).
model GoalIndicator {
  id                  String   @id @default(cuid())
  strategicGoalCycleId String
  strategicGoalCycle  StrategicGoalCycle @relation(fields: [strategicGoalCycleId], references: [id], onDelete: Cascade)
  nom                 String
  description         String?
  unite               String?
  sens                String   @default("hausse") // hausse (≥ cible) | baisse (≤ cible)
  valeurInitiale      Float?
  valeurCible         Float?
  frequence           String   @default("trimestrielle") // mensuelle | trimestrielle | semestrielle | annuelle | ponctuelle
  echeance            DateTime?
  responsableActorId  String?
  responsable         String?
  statut              String   @default("actif") // actif | atteint | abandonne
  principal           Boolean  @default(false)
  seuilAlerte         Float?
  parentIndicatorId   String?
  kpiId               String? // lien facultatif vers un Kpi d'initiative
  measures            GoalIndicatorMeasure[]
  actions             Action[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@unique([strategicGoalCycleId, parentIndicatorId])
  @@index([strategicGoalCycleId])
  @@index([parentIndicatorId])
}

// Valeur réellement constatée à une date donnée. « Valeur actuelle » = dernière mesure.
model GoalIndicatorMeasure {
  id              String   @id @default(cuid())
  goalIndicatorId String
  goalIndicator   GoalIndicator @relation(fields: [goalIndicatorId], references: [id], onDelete: Cascade)
  valeur          Float
  dateMesure      DateTime
  commentaire     String?
  source          String?
  auteur          String?
  createdAt       DateTime @default(now())

  @@index([goalIndicatorId, dateMesure])
}

// Lien d'un objectif avec un risque, une décision, un constat d'audit ou une exigence existants
// (aucun doublon). Une seule cible renseignée par ligne. Initiatives : InitiativeGoalContribution.
model StrategicGoalLink {
  id                   String   @id @default(cuid())
  strategicGoalCycleId String
  strategicGoalCycle   StrategicGoalCycle @relation(fields: [strategicGoalCycleId], references: [id], onDelete: Cascade)
  nature               String   @default("associe") // associe | justifie | contraint
  riskId               String?
  risk                 Risk?    @relation(fields: [riskId], references: [id], onDelete: Cascade)
  decisionId           String?
  decision             Decision? @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  auditFindingId       String?
  auditFinding         AuditFinding? @relation(fields: [auditFindingId], references: [id], onDelete: Cascade)
  qualityRequirementId String?
  qualityRequirement   QualityRequirement? @relation(fields: [qualityRequirementId], references: [id], onDelete: Cascade)
  createdAt            DateTime @default(now())

  @@unique([strategicGoalCycleId, riskId])
  @@unique([strategicGoalCycleId, decisionId])
  @@unique([strategicGoalCycleId, auditFindingId])
  @@unique([strategicGoalCycleId, qualityRequirementId])
}

// Applicabilité d'une exigence de référence (groupe) à un établissement + suivi local de conformité.
// L'exigence n'est jamais dupliquée. Actions, preuves, constats de l'établissement pointent vers l'exigence.
model RequirementApplicability {
  id                   String   @id @default(cuid())
  qualityRequirementId String
  qualityRequirement   QualityRequirement @relation(fields: [qualityRequirementId], references: [id], onDelete: Cascade)
  establishmentId      String
  establishment        Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  applicable           Boolean  @default(true)
  statutConformite     String   @default("non_evalue") // non_evalue | conforme | partiellement_conforme | non_conforme
  evaluation           String?
  evaluatedAt          DateTime?
  evaluatedBy          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt

  @@unique([qualityRequirementId, establishmentId])
  @@index([establishmentId])
}
